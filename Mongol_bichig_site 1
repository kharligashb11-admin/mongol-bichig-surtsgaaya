for(const m of modules){Object.assign(m,defaultTeacherState.modules.find(x=>x.id===m.id));Object.assign(m,teacherEdits.modules?.[m.id]||{});}
for(const l of lessons){Object.assign(l,defaultTeacherState.lessons.find(x=>x.id===l.id));Object.assign(l,teacherEdits.lessons?.[l.id]||{});}
for(const t of sourceTests){Object.assign(t,JSON.parse(JSON.stringify(defaultTeacherState.sourceTests.find(x=>x.id===t.id))));const edit=teacherEdits.tests?.[t.id];if(edit){t.name=edit.name||t.name;t.items=JSON.parse(JSON.stringify(edit.items||t.items));}}
for(let i=0;i<quizBank.length;i++){Object.assign(quizBank[i],defaultTeacherState.extra[i],teacherEdits.extra?.[i]||{});}
for(const [key,uri] of Object.entries(teacherEdits.images||{})){const [id,p]=key.split(':');if(pageImages[id]?.[Number(p)-1])pageImages[id][Number(p)-1]=uri;}
updateModuleCards();$('#sourceTestTopic').innerHTML=sourceTests.map(t=>'<option value="'+t.id+'">'+esc(t.name)+' · '+t.items.length+' оноо</option>').join('');$('#sourceTestTopic').value=sourceTests[0].id;renderLesson();renderSourceTest();if(!$('#chapterReader').hidden){$('#chapterTitle').textContent=activeModule.title;$('#chapterDescription').textContent=activeModule.desc;renderModulePage();}}
const previousTeacherModule=renderModulePage;
renderModulePage=function(){previousTeacherModule();const note=teacherEdits.modules?.[activeModule.id]?.note;if(note)$('#chapterFoundation').insertAdjacentHTML('beforeend','<div class="teacher-lesson-note"><b>Багшийн нэмэлт тайлбар</b><p>'+esc(note).replace(/\n/g,'<br>')+'</p></div>');};
function teacherTouch(){teacherEdits.format='mongol-bichig-teacher-v1';teacherEdits.updated=Date.now();applyTeacherEdits();persistTeacherEdits();}
function teacherTab(name){$$('[data-teacher-panel]').forEach(e=>e.hidden=e.dataset.teacherPanel!==name);$$('[data-teacher-tab]').forEach(e=>e.classList.toggle('active',e.dataset.teacherTab===name));}
$$('[data-teacher-tab]').forEach(b=>b.onclick=()=>teacherTab(b.dataset.teacherTab));
function fillTeacherSite(){const s=teacherEdits.site||{};$('#teacherSiteTitle').value=s.title||'Монгол бичиг сурцгаая';$('#teacherHeadline').value=s.headline||'Эх хэлээ суръя.\nӨв соёлоо өвлөе!';$('#teacherIntro').value=s.intro||$('.hero .intro').textContent;$('#teacherAuthor').value=s.author||'Б.Харлыгаш багш';}
$('#saveTeacherSite').onclick=()=>{if(!$('#teacherSiteTitle').value.trim()){$('#teacherStatus').textContent='Сайтын нэрээ оруулна уу.';return;}teacherEdits.site={title:$('#teacherSiteTitle').value.trim(),headline:$('#teacherHeadline').value.trim(),intro:$('#teacherIntro').value.trim(),author:$('#teacherAuthor').value.trim()};teacherTouch();};
function fillTeacherModule(){const m=modules.find(x=>x.id===$('#teacherModule').value);$('#teacherModuleTitle').value=m.title;$('#teacherModuleDesc').value=m.desc;$('#teacherModuleFocus').value=m.focus;$('#teacherModuleNote').value=teacherEdits.modules?.[m.id]?.note||'';$('#teacherImageDoc').value='guide';$('#teacherImagePage').innerHTML=Array.from({length:m.end-m.start+1},(_,i)=>'<option value="'+(m.start+i)+'">'+(m.start+i)+'-р хуудас</option>').join('');previewTeacherImage();}
function previewTeacherImage(){const doc=$('#teacherImageDoc').value||'guide',page=Number($('#teacherImagePage').value);$('#teacherImagePreview').innerHTML=exactPage(doc,page);$('#teacherImageStatus').textContent=teacherEdits.images?.[doc+':'+page]?'Энэ хуудсанд таны сонгосон зураг ашиглагдаж байна.':'Эх PDF-ийн өөрчлөгдөөгүй зураг.';}
$('#teacherModule').onchange=fillTeacherModule;$('#teacherImagePage').onchange=previewTeacherImage;
$('#saveTeacherModule').onclick=()=>{const id=$('#teacherModule').value;if(!$('#teacherModuleTitle').value.trim())return;teacherEdits.modules??={};teacherEdits.modules[id]={title:$('#teacherModuleTitle').value.trim(),desc:$('#teacherModuleDesc').value.trim(),focus:$('#teacherModuleFocus').value.trim(),note:$('#teacherModuleNote').value.trim()};teacherTouch();};
async function loadTeacherImage(file,key){if(!file)return;if(!['image/png','image/jpeg','image/webp'].includes(file.type)){$('#teacherStatus').textContent='PNG, JPG эсвэл WebP зураг сонгоно уу.';return;}if(file.size>10*1024*1024){$('#teacherStatus').textContent='10 МБ-аас бага хэмжээтэй зураг сонгоно уу.';return;}const uri=await new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(r.result);r.onerror=reject;r.readAsDataURL(file);});teacherEdits.images??={};teacherEdits.images[key]=uri;teacherTouch();previewTeacherImage();}
$('#teacherReplaceImage').onchange=()=>loadTeacherImage($('#teacherReplaceImage').files[0],$('#teacherImageDoc').value+':'+$('#teacherImagePage').value);
$('#teacherRestoreImage').onclick=()=>{const d=$('#teacherImageDoc').value,p=$('#teacherImagePage').value;delete (teacherEdits.images||{})[d+':'+p];pageImages[d][Number(p)-1]=JSON.parse($('#pageImageData').textContent)[d][Number(p)-1];teacherTouch();previewTeacherImage();};
function fillTeacherRule(){const l=lessons.find(x=>x.id===$('#teacherRule').value);$('#teacherRuleText').value=l.rule;$('#teacherRuleDetail').value=l.detail;$('#teacherRuleExamples').value=l.examples.map(([m,c])=>m+' | '+c).join('\n');}
$('#teacherRule').onchange=fillTeacherRule;
$('#saveTeacherRule').onclick=()=>{const id=$('#teacherRule').value;const examples=$('#teacherRuleExamples').value.split('\n').filter(s=>s.trim()).map(line=>{const i=line.indexOf('|');return i<0?[line.trim(),'']:[line.slice(0,i).trim(),line.slice(i+1).trim()]});teacherEdits.lessons??={};teacherEdits.lessons[id]={rule:$('#teacherRuleText').value,detail:$('#teacherRuleDetail').value,examples};teacherTouch();};
function fillTeacherTest(){const t=sourceTests.find(x=>x.id===$('#teacherTest').value);$('#teacherTestName').value=t.name;$('#teacherTestRows').innerHTML=t.items.map(([n,prompt,key],i)=>'<div class="teacher-test-row"><label>'+esc(n)+'. Асуултын тайлбар<input data-teacher-prompt="'+i+'" value="'+esc(prompt)+'"></label><label>Зөв хариу<select data-teacher-key="'+i+'">'+['А','Б','В'].map(k=>'<option'+(k===key?' selected':'')+'>'+k+'</option>').join('')+'</select></label></div>').join('');}
$('#teacherTest').onchange=fillTeacherTest;
$('#saveTeacherTest').onclick=()=>{const t=sourceTests.find(x=>x.id===$('#teacherTest').value);const prompts=$$('[data-teacher-prompt]'),keys=$$('[data-teacher-key]');teacherEdits.tests??={};teacherEdits.tests[t.id]={name:$('#teacherTestName').value.trim()||t.name,items:t.items.map(([n],i)=>[n,prompts[i].value,keys[i].value])};teacherTouch();};
function fillTeacherExtra(){const i=Number($('#teacherExtra').value),q=quizBank[i];$('#teacherExtraPrompt').value=q.text;$('#teacherExtraA').value=q.options[0];$('#teacherExtraB').value=q.options[1];$('#teacherExtraC').value=q.options[2];$('#teacherExtraKey').value=String(q.answer);$('#teacherExtraWhy').value=q.why;}
$('#teacherExtra').onchange=fillTeacherExtra;
$('#saveTeacherExtra').onclick=()=>{const i=Number($('#teacherExtra').value);teacherEdits.extra??={};teacherEdits.extra[i]={text:$('#teacherExtraPrompt').value,options:[$('#teacherExtraA').value,$('#teacherExtraB').value,$('#teacherExtraC').value],answer:Number($('#teacherExtraKey').value),why:$('#teacherExtraWhy').value};teacherTouch();};
function fillTeacher(){fillTeacherSite();$('#teacherModule').innerHTML=modules.map(m=>'<option value="'+m.id+'">'+esc(m.title)+'</option>').join('');$('#teacherModule').value=modules[0].id;fillTeacherModule();$('#teacherRule').innerHTML=lessons.map(l=>'<option value="'+l.id+'">'+esc(l.name)+'</option>').join('');$('#teacherRule').value=lessons[0].id;fillTeacherRule();$('#teacherTest').innerHTML=sourceTests.map(t=>'<option value="'+t.id+'">'+esc(t.name)+'</option>').join('');$('#teacherTest').value=sourceTests[0].id;fillTeacherTest();$('#teacherExtra').innerHTML=quizBank.map((q,i)=>'<option value="'+i+'">'+(i+1)+'. '+esc(q.text)+'</option>').join('');$('#teacherExtra').value='0';fillTeacherExtra();}
$('#openTeacher').onclick=()=>{fillTeacher();$('#teacherEditor').showModal();teacherTab('site');};$('#closeTeacher').onclick=()=>$('#teacherEditor').close();
function exportTeacherHTML(){const clone=document.documentElement.cloneNode(true);clone.querySelector('#teacherEditsData').textContent=JSON.stringify(teacherEdits).replaceAll('<','\\u003c');for(const id of ['lessonCards','courseCards','lessonNav','lessonDetail','quizBody','books','readerText','chapterContent','chapterFoundation','sourceTestText','sourceTestAnswers','sourceTestFeedback','resourceText','exerciseCards','readingCards','topicLinks','learnProgress','quizHistory','teacherImagePreview','teacherTestRows']){const e=clone.querySelector('#'+id);if(e)e.innerHTML='';}for(const id of ['teacherEditor','sourceImageModal'])clone.querySelector('#'+id)?.removeAttribute('open');clone.querySelector('#zoomImage')?.removeAttribute('src');clone.querySelector('#answerDraft').textContent='';clone.querySelectorAll('.nav button[data-go]').forEach(e=>{e.classList.toggle('active',e.dataset.go==='home');e.setAttribute('aria-current',e.dataset.go==='home'?'page':'false');});clone.querySelector('#resourceReader').hidden=true;clone.querySelector('#chapterReader').hidden=true;clone.querySelector('#readerWrap').hidden=true;clone.querySelectorAll('.view').forEach(e=>e.hidden=e.id!=='home');const blob=new Blob(['<!doctype html>\n'+clone.outerHTML],{type:'text/html;charset=utf-8'});const link=document.createElement('a');link.href=URL.createObjectURL(blob);link.download='Mongol_bichig_surtsgaaya_edited.html';link.click();setTimeout(()=>URL.revokeObjectURL(link.href),5000);$('#teacherStatus').textContent='✓ Зассан сайтыг татлаа. Шинэ HTML файлыг нээж шалгаад сурагчдадаа өгч болно.';}
$('#teacherExport').onclick=exportTeacherHTML;
$('#teacherBackup').onclick=()=>{teacherEdits.format='mongol-bichig-teacher-v1';const blob=new Blob([JSON.stringify(teacherEdits,null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='Mongol_bichig_teacher_edits.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),5000);};
$('#teacherImport').onchange=async()=>{const file=$('#teacherImport').files[0];if(!file)return;try{const v=JSON.parse(await file.text());if(!v||typeof v!=='object'||Array.isArray(v)||v.format!=='mongol-bichig-teacher-v1')throw Error('Format');for(const [k,uri] of Object.entries(v.images||{})){if(!/^(guide|practice):[0-9]+$/.test(k)||typeof uri!=='string'||!/^data:image\/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+$/.test(uri))throw Error('Image');}teacherEdits=v;teacherTouch();fillTeacher();$('#teacherStatus').textContent='✓ Өөрчлөлтүүдийг сэргээж орууллаа.';}catch{$('#teacherStatus').textContent='Зөв JSON нөөц файл сонгоно уу.';}};
mergeTeacherEdits();applyTeacherEdits();
(async()=>{try{const saved=await teacherReadDB();if(saved?.updated&&(!teacherEdits.updated||saved.updated>teacherEdits.updated)){teacherEdits=saved;applyTeacherEdits();}}catch{}})();

$('#teacherImageDoc').onchange=()=>{if($('#teacherImageDoc').value==='guide'){const m=modules.find(x=>x.id===$('#teacherModule').value);$('#teacherImagePage').innerHTML=Array.from({length:m.end-m.start+1},(_,i)=>'<option value="'+(m.start+i)+'">'+(m.start+i)+'-р хуудас</option>').join('');}else{$('#teacherImagePage').innerHTML=Array.from({length:10},(_,i)=>'<option value="'+(i+1)+'">'+(i+1)+'-р хуудас</option>').join('');}previewTeacherImage();};

const nationalViews=new Set(['national','learn','activities','exercises','reading','quiz','library','progress']);
const subjectGo=go;
go=function(id){subjectGo(id);$('#nationalNav').hidden=!nationalViews.has(id);if(!['exercises','reading'].includes(id))$('#resourceReader').hidden=true;const active=nationalViews.has(id)?'national':id;$$('.nav button').forEach(b=>{b.classList.toggle('active',b.dataset.go===active);b.setAttribute('aria-current',b.dataset.go===active?'page':'false');});$$('#nationalNav button').forEach(b=>b.classList.toggle('active',b.dataset.go===id));};
const subjectApply=applyTeacherEdits;
applyTeacherEdits=function(){subjectApply();for(const id of ['mongolian','literature']){const node=$('#'+id+'TeacherContent'),value=teacherEdits.subjects?.[id]||'';node.hidden=!value.trim();node.innerHTML=esc(value).replace(/\n/g,'<br>');}};
const subjectFill=fillTeacher;
fillTeacher=function(){subjectFill();$('#teacherMongolianContent').value=teacherEdits.subjects?.mongolian||'';$('#teacherLiteratureContent').value=teacherEdits.subjects?.literature||'';};
$('#saveTeacherSubjects').onclick=()=>{teacherEdits.subjects={mongolian:$('#teacherMongolianContent').value.trim(),literature:$('#teacherLiteratureContent').value.trim()};teacherTouch();};
const subjectExport=exportTeacherHTML;
exportTeacherHTML=function(){go('home');subjectExport();};
$('#teacherExport').onclick=exportTeacherHTML;
applyTeacherEdits();go('home');
</script></body></html>
